{
  "name": "steamwatch",
  "version": "1.0.1",
  "description": "Chrome extension for tracking Steam games with live player counts, local trend history, Twitch viewers, and alerts.",
  "author": "trevonerd / TREVISOFT",
  "license": "MIT",
  "private": true,
  "scripts": {
    "version-sync": "tsx scripts/sync-version.ts",
    "prebuild": "tsx scripts/sync-version.ts",
    "dev": "vite build --watch",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run test",
    "screenshots": "pnpm build && tsx scripts/store-screenshots.ts",
    "zip": "tsx scripts/package-zip.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "knip": "^6.42.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "zod": "^4.6.7"
  },
  "type": "module"
}

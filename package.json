{
  "name": "steamwatch",
  "version": "2.0.1.8",
  "description": "Chrome extension for tracking Steam games with live player counts, local trend history, Twitch viewers, and alerts.",
  "author": "trevonerd / TREVISOFT",
  "license": "MIT",
  "private": true,
  "scripts": {
    "version-sync": "tsx scripts/sync-version.ts",
    "prebuild": "tsx scripts/sync-version.ts",
    "dev": "vite build --watch",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@vitest/coverage-v8": "^1.6.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.9",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-web-extension": "^4.5.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "zod": "^3.23.8"
  }
}
